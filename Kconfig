# Kconfig — описание параметров сборки proshivkaOS NEXT.
#
# Формат намеренно тот же, что у ядра Linux: если проект дорастёт до
# menuconfig, достаточно будет поставить kconfig-frontends, и этот файл
# заработает как есть. Пока же он выполняет две задачи попроще, но не менее
# полезные: служит единым списком всего, что вообще можно включить, и
# документирует, от чего каждая опция зависит.
#
# Сейчас значения берутся не отсюда, а из готовых наборов в configs/:
#
#     make ARCH=arm64 BOARD=mido touch
#
# читает configs/mido_defconfig и превращает каждую строку CONFIG_X=y в
# макрос -DCONFIG_X, а заодно решает, какие .c-файлы попадут в сборку.
# Разбор — в Makefile, раздел «Конфигурация платы».

mainmenu "proshivkaOS NEXT"

choice
	prompt "Целевая плата"
	default BOARD_QEMU
	help
	  Плата определяет запасные адреса периферии — те, что используются,
	  когда загрузчик не передал device tree или нужного узла в нём не
	  оказалось. Основной источник адресов всё равно дерево.

config BOARD_QEMU
	bool "QEMU virt (эмулятор)"
	help
	  Виртуальная машина qemu-system-aarch64 -M virt. Экран через ramfb,
	  ввод через virtio-input, порт PL011. Всё это существует только
	  внутри эмулятора.

config BOARD_MIDO
	bool "Xiaomi Redmi Note 4/4X (mido, MSM8953)"
	help
	  Реальный телефон на Snapdragon 625. Экран — готовый фреймбуфер,
	  оставленный загрузчиком; порт — Qualcomm UARTDM; тачскрин —
	  FocalTech FT5435 на шине I2C.

endchoice

menu "Драйверы последовательного порта"

config UART_PL011
	bool "ARM PrimeCell PL011"
	default y
	help
	  Стандартный порт ARM. Есть в QEMU virt и на большинстве плат
	  общего назначения.

config UART_MSM
	bool "Qualcomm UARTDM"
	default y
	help
	  Порт на процессорах Snapdragon. Устроен вокруг передачи пакетами:
	  перед каждой отправкой требуется объявить длину.

	  Оба драйвера можно держать в сборке одновременно — нужный
	  выбирается во время выполнения по device tree.

endmenu

menu "Ввод"

config TOUCH_FT5X06
	bool "Тачскрин FocalTech FT5x06 / FT5435"
	depends on BOARD_MIDO
	select I2C_QUP
	select TLMM_GPIO
	select CLK_GCC_MSM8953
	help
	  Ёмкостный контроллер сенсора. Сам сканирует матрицу и отдаёт по
	  I2C готовый список точек касания, уже в пикселях панели.

	  Требует шины I2C, управления выводами (сброс и линия прерывания)
	  и включённого тактирования — поэтому тянет за собой три драйвера
	  ниже.

config I2C_QUP
	bool "Ведущий I2C на Qualcomm QUP v2"
	help
	  Универсальный блок Qualcomm в режиме I2C. Транзакция описывается
	  потоком командных меток, а не отдельными регистрами.

config TLMM_GPIO
	bool "Выводы общего назначения Qualcomm TLMM"
	help
	  У каждого вывода свой блок регистров размером 4 КиБ, адрес
	  считается умножением номера вывода.

config CLK_GCC_MSM8953
	bool "Тактирование периферии MSM8953"
	help
	  На Snapdragon периферия по умолчанию обесточена по тактам.
	  Порт UART достаётся уже включённым от загрузчика, а шину I2C
	  тачскрина приходится поднимать самостоятельно.

endmenu

menu "Отладка"

config PMIC_SPMI
	bool "Источники питания микросхемы PM8953 (шина SPMI)"
	depends on BOARD_MIDO
	help
	  Прямой доступ к микросхеме питания, минуя сопроцессор питания.
	  Нужен и тачскрину, и приёмопередатчику USB: загрузчик, уходя,
	  гасит источники, которыми сам не пользуется.

	  Перед записью узел опрашивается: пишем, только если он сам
	  подтвердил, что он источник питания. Напряжения не трогаем.

config RPM_SMD
	bool "Сопроцессор питания (SMD через общую память)"
	depends on BOARD_MIDO
	help
	  Часть источников питания принадлежит не нам, а сопроцессору
	  питания: прямая запись в микросхему для них закрыта и роняет
	  процессор. Включают их просьбой через общую память.

	  Без этого не работает тачскрин: его источник 2.85 В как раз из
	  таких.

config RPM_HANDSHAKE
	bool "Открывать канал к сопроцессору питания (опасно)"
	depends on RPM_SMD
	help
	  Без этого признака система только смотрит на состояние канала и
	  докладывает его. С ним — пробует открыть канал по-настоящему.

	  Выделено отдельно не из осторожности вообще, а по опыту: попытка
	  рукопожатия дважды подвешивала аппарат наглухо, и оба раза
	  оживить его можно было только кнопкой питания.

config USB_DWC3
	bool "USB в режиме устройства (Synopsys DWC3 в обвязке Qualcomm)"
	depends on BOARD_MIDO
	select CLK_GCC_MSM8953
	select PMIC_SPMI
	help
	  Поднимает контроллер USB как устройство: компьютер видит телефон
	  и может читать журнал загрузки прямо во время работы, не дожидаясь
	  перезагрузки и не поднимая recovery.

	  Требует некэшируемой области памяти для обмена — она выделена в
	  компоновщике (__dma_start) и отображается в mmu.c.

config LOG_RAMOOPS
	bool "Журнал, переживающий перезагрузку (ramoops)"
	depends on BOARD_MIDO
	help
	  Отладочный порт телефона выведен на разъём наушников и требует
	  паяного кабеля с делителем напряжения. Пока его нет, система,
	  упавшая до первой строки вывода, неотличима от системы, до которой
	  загрузчик вообще не доехал: и то и другое выглядит как чёрный
	  экран и обычная загрузка Android.

	  Эта возможность пишет тот же вывод в область ОЗУ, которую телефон
	  исключил из общего пула ради своего посмертного журнала. Она
	  переживает перезагрузку, поэтому лог читается уже из Android:

	      adb shell su -c 'cat /sys/fs/pstore/console-ramoops'

	  Первая метка ставится в boot.S до спуска из EL2 — то есть раньше,
	  чем что-либо вообще может сломаться.

config EARLY_FB_MARKS
	bool "Полосы на экране на ранних этапах загрузки"
	depends on BOARD_MIDO
	help
	  Закрашивает полосу во весь экран на каждом этапе старта: получено
	  управление, образ перемещён, .bss обнулён, уходим в C.

	  Нужно там, где отладочный порт недоступен, а система молчит. Без
	  этого "ядро не запустилось" и "ядро запустилось и упало через
	  миллисекунду" выглядят с телефона одинаково: экран загрузчика,
	  сброс, обычная загрузка Android. С полосами достаточно посмотреть
	  на экран — сколько их успело появиться, до того места и дошло.

	  Рисуется прямо в фреймбуфер, оставленный загрузчиком, ещё до
	  включения MMU и до первой строки на C, то есть раньше, чем что-либо
	  может сломаться.

endmenu

menu "Экран"

config FB_FROM_BOOTLOADER
	bool "Использовать фреймбуфер, оставленный загрузчиком"
	depends on BOARD_MIDO
	help
	  Загрузчик телефона уже настроил контроллер дисплея, чтобы показать
	  свой логотип, и оставил рабочий фреймбуфер. Полноценный драйвер
	  DSI при этом не нужен — достаточно писать по готовому адресу.

config FB_RAMFB
	bool "Экран через ramfb (только эмулятор)"
	depends on BOARD_QEMU
	default y
	help
	  Устройство гипервизора: мы сообщаем QEMU адрес своего буфера, и
	  тот показывает его как экран.

endmenu
