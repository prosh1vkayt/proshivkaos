#!/bin/sh
# tools/posdev — отладка proshivkaOS на подключённом телефоне.
#
# ЗАЧЕМ. До сих пор единственным способом узнать, что происходит при
# загрузке, была фотография экрана: система печатает на нём ход загрузки,
# потому что отладочный порт выведен на разъём наушников и без паяного
# кабеля молчит. Фотография работает, но круг получается длинный и живой
# человек в нём обязателен.
#
# Эта утилита закрывает круг. Система пишет тот же вывод в область ОЗУ,
# которую телефон исключил из общего пула ради посмертного журнала. Она
# переживает перезагрузку, и её содержимое можно вытащить на компьютер.
#
# ПОЧЕМУ ЧЕРЕЗ RECOVERY, А НЕ ЧЕРЕЗ ROOT. Чтобы прочитать журнал в
# Android, нужны права администратора, а их установка меняет систему и
# ломает проверку целостности. Recovery даёт корневую оболочку по adb и
# при этом ничего не устанавливает: он загружается в память командой
# fastboot boot и после перезагрузки не оставляет следов.
#
# ИСПОЛЬЗОВАНИЕ
#   posdev doctor          проверить окружение
#   posdev build           собрать образ
#   posdev run             загрузить образ на телефон
#   posdev usb             слушать журнал по проводу (Ctrl-C — выход)
#   posdev dump            забрать журнал по проводу и выйти самому
#   posdev reboot [куда]   перезагрузить телефон: bootloader (по умолчанию)
#                          или system
#   posdev log             вытащить журнал прошлой загрузки (через recovery)
#   posdev cycle           весь круг: собрать, загрузить, забрать журнал и
#                          вернуть телефон в загрузчик — без рук
#
# ПЕРЕМЕННЫЕ
#   POSDEV_DONOR    boot.img прошивки, в который подменяется ядро
#   POSDEV_RECOVERY образ recovery для чтения журнала
#   POSDEV_WAIT     сколько секунд давать системе поработать (по умолчанию 25)
#   POSDEV_VIA      usb (по умолчанию) или recovery — каким путём брать журнал

set -u

ROOT=$(cd "$(dirname "$0")/.." && pwd)
WAIT=${POSDEV_WAIT:-25}
OUT="$ROOT/build/arm64-mido/posdev.log"

say()  { printf '%s\n' "$*"; }
die()  { printf 'posdev: %s\n' "$*" >&2; exit 1; }

# Ищем donor и recovery там, где они обычно лежат, но позволяем задать явно.
find_donor() {
    [ -n "${POSDEV_DONOR:-}" ] && { echo "$POSDEV_DONOR"; return; }
    for f in "$HOME/mido/boot_pixelexperience.img" "$HOME/mido/flash/images/boot.img"; do
        [ -f "$f" ] && { echo "$f"; return; }
    done
}

find_recovery() {
    [ -n "${POSDEV_RECOVERY:-}" ] && { echo "$POSDEV_RECOVERY"; return; }
    # Берём самый свежий образ recovery для этого аппарата.
    ls -t "$HOME"/Downloads/*mido*.img 2>/dev/null | grep -i -m1 -E 'twrp|recovery'
}

wait_fastboot() {
    say "posdev: жду телефон в режиме загрузчика..."
    n=0
    while [ "$n" -lt 60 ]; do
        [ -n "$(fastboot devices 2>/dev/null)" ] && return 0
        n=$((n + 1))
        # Ждём секунду, не полагаясь на sleep с дробями.
        sleep 1
    done
    return 1
}

wait_adb() {
    say "posdev: жду adb..."
    adb wait-for-device >/dev/null 2>&1 &
    pid=$!
    n=0
    while [ "$n" -lt 90 ]; do
        [ -n "$(adb devices 2>/dev/null | sed -n '2p')" ] && { kill $pid 2>/dev/null; return 0; }
        n=$((n + 1)); sleep 1
    done
    kill $pid 2>/dev/null
    return 1
}

cmd_doctor() {
    ok=0
    for t in fastboot adb make magiskboot; do
        if command -v "$t" >/dev/null 2>&1; then say "  $t: есть"
        else say "  $t: НЕТ"; ok=1; fi
    done
    if python3 -c 'import usb.core' 2>/dev/null; then say "  pyusb: есть"
    else say "  pyusb: НЕТ (pip3 install pyusb) — журнал по проводу не заработает"; fi
    d=$(find_donor);    [ -n "$d" ] && say "  донор: $d"       || { say "  донор: НЕ НАЙДЕН"; ok=1; }
    r=$(find_recovery); [ -n "$r" ] && say "  recovery: $r"    || say "  recovery: не найден (нужен только для 'log')"
    say "  устройство adb: $(adb devices 2>/dev/null | sed -n '2p' | cut -f1)"
    say "  устройство fastboot: $(fastboot devices 2>/dev/null | cut -f1)"
    return $ok
}

cmd_build() {
    d=$(find_donor)
    [ -n "$d" ] || die "не найден boot.img прошивки; задайте POSDEV_DONOR"
    say "posdev: собираю с донором $d"
    ( cd "$ROOT" && make ARCH=arm64 BOARD=mido mido-swap DONOR="$d" \
        ${POSDEV_EXTRA:+EXTRA_CFLAGS="$POSDEV_EXTRA"} ) \
        || die "сборка не удалась"
    say "posdev: готово: $ROOT/build/arm64-mido/proshivkaos_boot_swap.img"
}

cmd_run() {
    img="$ROOT/build/arm64-mido/proshivkaos_boot_swap.img"
    [ -f "$img" ] || die "образа нет, сначала: posdev build"

    # Если телефон в Android — переводим его в загрузчик сами.
    adb_line=$(adb devices 2>/dev/null | sed -n '2p')
    case "$adb_line" in
        *unauthorized*)
            # Молчать здесь нельзя: команда просто не дойдёт, и минуту
            # спустя всё выглядит как зависший телефон, хотя на экране
            # висит вопрос, которого никто не видел.
            die "adb не разрешён — на телефоне висит запрос «Разрешить отладку по USB?»; примите его" ;;
        *device*)
            adb reboot bootloader >/dev/null 2>&1 ;;
    esac

    # Если он уже в proshivkaOS — просим её саму уйти в загрузчик. Это и
    # замыкает круг: человек у стола больше не нужен ни на одном шаге.
    if python3 -c 'import usb.core,sys; sys.exit(0 if usb.core.find(idVendor=0x1209,idProduct=0x0001) else 1)' 2>/dev/null; then
        say "posdev: телефон в proshivkaOS — прошу её уйти в загрузчик"
        python3 "$ROOT/tools/posdev-usb.py" cmd b 5 >/dev/null 2>&1
    fi

    wait_fastboot || die "телефон не появился в режиме загрузчика"

    say "posdev: запускаю образ (в память, без записи)"
    fastboot boot "$img" || die "загрузчик отказался принять образ"
}

cmd_log() {
    r=$(find_recovery)
    [ -n "$r" ] || die "не найден образ recovery; задайте POSDEV_RECOVERY"

    wait_fastboot || die "телефон не в режиме загрузчика — переведите его туда"
    say "posdev: поднимаю recovery для чтения журнала"
    fastboot boot "$r" || die "recovery не загрузился"
    wait_adb || die "adb не дождался recovery"

    mkdir -p "$(dirname "$OUT")"
    # Сначала штатный путь: ядро само отдаёт журнал прошлой загрузки.
    adb shell 'cat /sys/fs/pstore/console-ramoops 2>/dev/null' > "$OUT" 2>/dev/null

    if [ ! -s "$OUT" ]; then
        # Запасной путь: читаем область напрямую. В recovery это можно —
        # там оболочка работает с правами администратора.
        say "posdev: pstore пуст, читаю область напрямую"
        adb shell 'dd if=/dev/mem bs=4096 skip=655223 count=64 2>/dev/null' \
            | LC_ALL=C tr -cd '\11\12\15\40-\176' > "$OUT" 2>/dev/null
    fi

    if [ -s "$OUT" ]; then
        say "posdev: журнал сохранён в $OUT"
        say "-----------------------------------------------"
        cat "$OUT"
        say "-----------------------------------------------"
    else
        die "журнал пуст: область не сохранилась (холодная перезагрузка) либо адрес другой"
    fi
}

cmd_usb() {
    # Журнал по проводу. Система сама поднимает контроллер USB и
    # представляется компьютеру устройством, поэтому ни recovery, ни
    # перезагрузка не нужны: строки приходят, пока телефон работает.
    mkdir -p "$(dirname "$OUT")"
    : > "$OUT"
    python3 "$ROOT/tools/posdev-usb.py" listen "${1:-60}" "$OUT"
}

cmd_dump() {
    # То же самое, но выходит само, когда провод замолчал. На этом и
    # держится круг без человека у стола.
    mkdir -p "$(dirname "$OUT")"
    : > "$OUT"
    python3 "$ROOT/tools/posdev-usb.py" dump "${1:-40}" "$OUT"
}

cmd_reboot() {
    case "${1:-bootloader}" in
        system|sys) ch=s; where="в систему" ;;
        *)          ch=b; where="в загрузчик" ;;
    esac
    say "posdev: перезагружаю $where"
    python3 "$ROOT/tools/posdev-usb.py" cmd "$ch" "${2:-20}"
}

cmd_cycle() {
    # Образ собирается с отладочным признаком: система докладывает итог
    # опроса тачскрина в журнал. Если тачскрин не поднялся — заливает
    # экран дышащим красным, это знак, что можно перезагружать. Если
    # поднялся — идёт работать дальше, и его можно потрогать.
    #
    # Признак назывался CONFIG_DEBUG_AUTOFASTBOOT, пока система пыталась
    # вернуться в загрузчик сама. Та попытка подвешивала аппарат и была
    # убрана, а имя здесь осталось висеть в пустоту: сборка молча
    # получалась обычной, без единой отладочной строки в журнале.
    #
    # Журнал берётся по проводу: телефон появляется на нём сам через
    # несколько секунд после запуска образа и рассказывает всё прямо во
    # время работы. Длинный путь через recovery остался запасным — на
    # случай, если USB не поднялся, а узнать почему всё равно надо.
    POSDEV_EXTRA="${POSDEV_EXTRA:-} -DCONFIG_DEBUG_TOUCH_PROBE"
    export POSDEV_EXTRA
    cmd_build
    cmd_run

    if [ "${POSDEV_VIA:-usb}" = "usb" ]; then
        # Круг без рук: забрать журнал и сразу вернуть телефон в
        # загрузчик, чтобы следующий заход начинался без человека.
        if cmd_dump "$WAIT"; then
            say "posdev: журнал в $OUT"
            cmd_reboot bootloader
            return 0
        fi
        say "posdev: по проводу не отозвался — иду длинным путём"
    fi

    # Возвращать телефон в загрузчик приходится вручную (громкость-вниз с
    # питанием). Возврат по собственной воле пробовали: он подвешивал
    # аппарат, и от него отказались в пользу явного сигнала человеку.
    say "posdev: даю системе $WAIT секунд"
    n=0; while [ "$n" -lt "$WAIT" ]; do n=$((n + 1)); sleep 1; done
    say "posdev: экран задышал красным? верните телефон в загрузчик:"
    say "         громкость-вниз вместе с питанием"
    cmd_log
}

case "${1:-}" in
    doctor) cmd_doctor ;;
    build)  cmd_build ;;
    run)    cmd_run ;;
    usb)    shift; cmd_usb "${1:-60}" ;;
    dump)   shift; cmd_dump "${1:-40}" ;;
    reboot) shift; cmd_reboot "${1:-bootloader}" ;;
    log)    cmd_log ;;
    cycle)  cmd_cycle ;;
    *)      sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
